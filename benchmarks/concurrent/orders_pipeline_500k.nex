// orders_pipeline 500K orders 版：纯纤程模型（零 syscall）
struct Order {
    id: i64,
    amount: f64,
    cat: i64,
}
struct Agg {
    total: f64,
    count: i64,
    cat0: f64,
    cat1: f64,
    cat2: f64,
    cat3: f64,
}

fn worker(ch_in: Channel<Order>, ch_out: Channel<Agg>, n: i64) {
    let mut agg = Agg { total: 0.0, count: 0, cat0: 0.0, cat1: 0.0, cat2: 0.0, cat3: 0.0 }
    for i in [0..n] {
        let o = ch_in.recv()
        agg.total = agg.total + o.amount
        agg.count = agg.count + 1
        if o.cat == 0 { agg.cat0 = agg.cat0 + o.amount }
        else if o.cat == 1 { agg.cat1 = agg.cat1 + o.amount }
        else if o.cat == 2 { agg.cat2 = agg.cat2 + o.amount }
        else { agg.cat3 = agg.cat3 + o.amount }
    }
    ch_out.send(agg)
}

fn main() -> i32 {
    let ch_in = Channel<Order>::bounded(64)
    let ch_out = Channel<Agg>::bounded(4)
    // producer 也进纤程 → 全部纤程模型，channel 交互零 syscall
    let wp = spawn {
        let mut j: i64 = 0
        while j < 500000 {
            let m: i64 = j % 97
            ch_in.send(Order { id: j, amount: m as f64 + 1.0, cat: j % 4 })
            j = j + 1
        }
    }
    let w1 = spawn { worker(ch_in, ch_out, 250000) }
    let w2 = spawn { worker(ch_in, ch_out, 250000) }
    wp.await()
    let a1 = ch_out.recv()
    let a2 = ch_out.recv()
    w1.await(); w2.await()
    let total = Agg { total: a1.total + a2.total, count: a1.count + a2.count, cat0: a1.cat0 + a2.cat0, cat1: a1.cat1 + a2.cat1, cat2: a1.cat2 + a2.cat2, cat3: a1.cat3 + a2.cat3 }
    println(f"count={total.count}")
    if total.count != 500000 { println("MISMATCH"); return 1 }
    println("CHECKSUM OK")
    return 0
}
