fn main() -> i32 {
    let n: i64 = 5000000
    let mut flags: List<i64> = List.new(5000000)
    // 预分配 capacity，push 不会触发 realloc（CPU 省了！）
    let mut i: i64 = 0
    while i < n { flags.push(1); i = i + 1 }
    let mut p: i64 = 2
    while p * p < n {
        if flags[p as usize] == 1 {
            let mut j: i64 = p * p
            while j < n { flags[j as usize] = 0; j = j + p }
        }
        p = p + 1
    }
    let mut count: i64 = 0
    let mut k: i64 = 2
    while k < n { count = count + flags[k as usize]; k = k + 1 }
    print(count)
    return 0
}
