fn mandel(cx: f64, cy: f64, max_iter: i32) -> i32 {
    let mut x: f64 = 0.0
    let mut y: f64 = 0.0
    let mut i: i32 = 0
    while i < max_iter {
        let x2 = x * x
        let y2 = y * y
        if x2 + y2 > 4.0 { return i }
        let xt = x2 - y2 + cx
        y = 2.0 * x * y + cy
        x = xt
        i = i + 1
    }
    return max_iter
}

fn main() -> i32 {
    let n: i32 = 600
    let mut total: i64 = 0
    let mut py: i32 = 0
    while py < n {
        let mut px: i32 = 0
        while px < n {
            let cx = (px as f64) / (n as f64) * 3.0 - 2.0
            let cy = (py as f64) / (n as f64) * 2.0 - 1.0
            total = total + (mandel(cx, cy, 100) as i64)
            px = px + 1
        }
        py = py + 1
    }
    print(total)
    return 0
}