// ============================================================
// 20 — 构建库并引用：模块库工程
// ============================================================
// 目录结构：
//   20_lib_demo/
//   ├── main.nex              ← 入口（import 引用库）
//   └── lib/
//       └── mathx/
//           ├── mod.nex       ← 库入口（pub 成员 + 内部私有助手）
//           └── stats.nex     ← 同包第二文件（同符号空间）
//
// "构建并引用"的两步：
//   ① 库侧自检（库文件单独可编译）：
//        nex lib/mathx/mod.nex          # 只验证编译，产可执行体（无 main 则空 main）
//   ② 消费侧编译运行（import 按目录路径解析）：
//        nex main.nex -o demo && ./demo
//
// 语义规则：
//   * 只有 `pub` 声明可被 import；无 pub 的成员是模块私有（封装边界）；
//   * 同目录多文件的 pub 实名并入同一符号空间（mod.nex 可直用 stats.nex 的成员）。

import lib.mathx

fn main() {
    let xs: List<f64> = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
    let m = mean(xs)
    println(m) // 5.0
    println(variance(xs)) // 4.0
}
