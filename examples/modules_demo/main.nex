// ============================================================
// 16 — 多文件项目：模块与包
// ============================================================
// 目录结构：
//   modules_demo/
//   ├── main.nex              ← 本文件（程序入口）
//   └── modules/
//       └── geometry/
//           ├── mod.nex       ← 包入口（pub 成员）
//           └── point.nex     ← 同包第二文件（同符号空间）
//
// 构建（在 modules_demo/ 目录下）：
//   nex main.nex -o demo && ./demo
//
// 规则速记：
//   * `import modules.geometry.{dot, Point}` 只并入点名的成员；
//   * `import modules.geometry.*` 整包并入（同目录多文件的 pub 实名全部可用）；
//   * 模块内不带 `pub` 的声明是模块私有的，外部 import 不到。

import modules.geometry

fn main() {
    let a = Point(1, 2)
    let b = Point(3, 4)

    println(dot(a, b)) // 1*3 + 2*4 = 11
    println(a.norm()) // sqrt(1+4) ≈ 2.236
    println(b.x) // pub 字段跨模块可读
}
