// ============================================================
// 06 — 闭包：捕获环境的函数值
// ============================================================

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x)
}

fn main() {
    // 表达式闭包：`fn(参数) => 表达式`。
    let add = fn(a: i64, b: i64) => a + b
    println(add(2, 3)) // 5

    // 捕获：闭包记住创建它时所在作用域的变量。
    let base = 100
    let offset = fn(x: i64) => x + base
    println(offset(7)) // 107

    // 闭包作实参传给高阶函数（调用点捕获回填）。
    let inc = fn(x: i64) => x + 1
    let dbl = fn(x: i64) => x * 2
    println(apply(inc, 10)) // 11
    println(apply(dbl, 10)) // 20
}
